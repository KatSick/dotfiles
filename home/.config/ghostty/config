# Ghostty config. Full reference: `ghostty +show-config --default --docs`
# Theme names: `ghostty +list-themes`

# Hack Nerd Font Mono is the fixed-width build - it keeps the starship glyphs
# on the cell grid. The plain "Hack Nerd Font" family renders them wider.
font-family = Hack Nerd Font Mono
font-size = 15

# matches Zed, which pins itself to One Dark (home/.config/zed/settings.json).
# Ghostty calls that palette "Atom One Dark" - it is the same Atom theme.
theme = Atom One Dark

window-padding-x = 8
window-padding-y = 8

# dim splits that don't have focus
unfocused-split-opacity = 0.7

# lets zsh report cwd and prompt marks, so new splits/tabs open in the same dir
shell-integration = zsh

# option should send Meta, not compose accented characters
macos-option-as-alt = true

confirm-close-surface = false
