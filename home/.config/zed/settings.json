// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // The declarative record of which extensions this machine should have. Zed
  // installs anything true here on startup, so a fresh machine converges after
  // one launch. The downloaded payloads under
  // ~/Library/Application Support/Zed/extensions/ are build artifacts and stay
  // untracked. Note this only installs: an extension removed from this list is
  // left in place on machines that already have it, so drop it to `false` for
  // one sync if you want it actually gone.
  "auto_install_extensions": {
    "git-firefly": true,
    "html": true,
    "log": true,
    "nix": true,
    "toml": true
  },
  "project_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
